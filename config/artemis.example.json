{
  // Copy to config/artemis.json and edit. Comments are allowed.
  // Secrets are NOT stored here: export KALSHI_API_KEY_ID and
  // KALSHI_PRIVATE_KEY_PATH (path to the .pem you downloaded from Kalshi).

  "mode": "paper",                 // "paper" | "live"  (live also needs --live on the CLI)

  "kalshi": {
    "environment": "demo",         // "demo" (demo-api.kalshi.co) | "prod"
    "read_rate_per_sec": 15,       // keep below your API tier's read budget
    "write_rate_per_sec": 8,
    "timeout_ms": 5000,
    "max_retries": 3,
    "orderbook_batch_size": 50,
    "subaccount": 0
  },

  "polymarket": {
    "enabled": false,              // cross-venue detection (paper only for the Polymarket leg)
    "clob_url": "https://clob.polymarket.com",
    "market_map_path": "config/market_map.json",
    "fee_model": "bps",            // "bps" (CLOB: bps*C*min(p,1-p)) | "quadratic" (Polymarket US)
    "fee_bps": 0,
    "quadratic_theta": 0.0695
  },

  "universe": {
    "refresh_seconds": 60,
    "series_allow": [],            // e.g. ["KXFED*", "KXHIGH*"]; empty = all series
    "series_deny": [],
    "event_allow": [],             // always tracked, regardless of ranking
    "event_deny": [],
    "exhaustive_series": [],       // ONLY list series whose outcomes always cover every case
    "exhaustive_events": [],       //   (enables YES-basket arbitrage on them)
    "min_markets": 2,
    "max_markets": 80,
    "max_events_tracked": 250,
    "prefilter_slack_cents": 4.0,
    "min_seconds_to_close": 300,
    "max_pages": 50
  },

  "feed": {
    "poll_interval_ms": 1000,
    "max_book_age_ms": 3000,
    "queue_capacity": 8192
  },

  "strategy": {
    "enable_no_basket": true,
    "enable_yes_basket": true,
    "enable_cross_venue": true,
    "min_profit_usd": 0.25,
    "min_edge_cents": 0.5,
    "min_roi": 0.002,
    "min_leg_roi": 0.02,           // NO basket: skip legs whose own edge is < 2% of their price
    "max_contracts": 250,
    "confirmations": 1,
    "kalshi_taker_rate": 0.07,
    "safety_margin_cents": 0.1
  },

  "basis": { "enabled": true, "half_life": 120, "warmup": 30, "entry_z": 2.5, "exit_z": 0.5 },

  "risk": {
    "max_cost_per_trade_usd": 100,
    "max_total_exposure_usd": 1000,
    "max_daily_loss_usd": 50,
    "max_trades_per_hour": 60,
    "cooldown_ms": 5000,
    "max_open_baskets_per_event": 3,
    "balance_utilisation": 0.8,
    "kill_switch_file": "KILL",
    "max_consecutive_failures": 3
  },

  "execution": {
    "leg_mode": "sequential",      // "sequential" (thinnest leg first) | "batch"
    "max_completion_retries": 1,
    "unwind_on_failure": true,
    "max_leg_loss_usd": 5
  },

  "backtest": { "latency_ms": 250, "starting_equity_usd": 1000, "results_prefix": "results" },

  "output": { "dir": "output", "log_file": "output/artemis.log", "log_level": "info" }
}
